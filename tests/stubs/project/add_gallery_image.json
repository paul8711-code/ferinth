{
    "request": {
        "method": "POST",
        "urlPath": "/project/test_project/gallery",
        "queryParameters": {
            "ext": "png",
            "featured": true,
            "title": "test_image",
            "description": "test image"
        },
        "headers": {
            "Authorization": "token"
        },
        "bodyPatterns": [
            {
                "equalTo": "image data"
            }
        ]
    },
    "response": {
        "status": 204
    }
}
